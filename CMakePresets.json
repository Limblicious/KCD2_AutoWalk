{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "vs2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "LIBKCD2_ROOT": "${sourceDir}/.deps/libKCD2"
      }
    }
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "vs2022", "configuration": "Debug", "targets": ["KCD2_AutoWalk"]},
    {"name": "release", "configurePreset": "vs2022", "configuration": "Release", "targets": ["KCD2_AutoWalk"]}
  ]
}
