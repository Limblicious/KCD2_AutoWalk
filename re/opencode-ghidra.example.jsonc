{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "ghidra": {
        "type": "remote",
        "url": "http://127.0.0.1:8080/mcp",
        "oauth": false,
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 600000
        }
      }
    }
  }
}
